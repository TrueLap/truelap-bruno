meta {
  name: Criar Treino
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/workouts?coachId={{coachId}}
  body: json
  auth: inherit
}

params:query {
  coachId: {{coachId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "athleteId": 1,
    "scheduledDate": "2026-11-10",
    "sport": "RUNNING",
    "title": "Treino Força",
    "notes": null
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
