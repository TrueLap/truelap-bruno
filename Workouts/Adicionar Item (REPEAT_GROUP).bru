meta {
  name: Adicionar Item (REPEAT_GROUP)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/workouts/{{workoutId}}/items?coachId={{coachId}}
  body: json
  auth: inherit
}

params:query {
  coachId: {{coachId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "REPEAT_GROUP",
    "repetitions": 3
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
